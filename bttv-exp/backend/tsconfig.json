{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",
  "include": ["src/**/*.ts", "src/**/*.js"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "target": "es2024",
    "types": ["node"],

    "allowJs": true,
    "checkJs": true,
    
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16"
  }
}